<section id="home" class="hero">
    <div class="container hero-container">
        <div class="hero-content">
            <!-- HUD System Live Terminal Widget -->
            <div class="hud-terminal-widget">
                <div class="terminal-header">
                    <span class="term-dot green"></span>
                    <span class="term-dot yellow"></span>
                    <span class="term-dot red"></span>
                    <span class="term-title">HUD_TERMINAL // v3.0</span>
                </div>
                <div class="terminal-body">
                    <span class="term-prompt">&gt;</span> <span class="term-cmd">SYS_STATUS: ONLINE</span> | <span class="term-accent">SECURITY: MAXIMUM (E2EE)</span>
                </div>
            </div>

            <h1 class="hero-title">
                <%= t('hero_greeting') %><span class="cyber-glitch-text" data-text="Ricardo">Ricardo</span>
            </h1>
            
            <h2 class="typing-text">
                <span class="hud-bracket">[</span><%= t('hero_typing_prefix') %><span class="typed-text"></span><span class="cursor">_</span><span class="hud-bracket">]</span>
            </h2>
            
            <p class="hero-description">
                <%= t('hero_description') %>
            </p>
            
            <div class="cta-buttons">
                <a href="#projects" class="btn btn-laser btn-primary">
                    <i class="fas fa-terminal"></i>
                    <%= t('hero_btn_work') %>
                </a>
                <a href="<%= linkTo('/contact') %>" class="btn btn-laser btn-secondary"
                    onclick="window.location.href='<%= linkTo('/contact') %>'; return false;">
                    <i class="fas fa-paper-plane"></i>
                    <%= t('hero_btn_contact') %>
                </a>
            </div>

            <!-- Social Links -->
            <div class="social-links">
                <a href="https://github.com/RKRomao" class="social-link" target="_blank" rel="noopener noreferrer"
                    aria-label="GitHub">
                    <i class="fab fa-github"></i>
                </a>
                <a href="https://www.linkedin.com/in/ricardo-romão-0a9904213" class="social-link" target="_blank"
                    rel="noopener noreferrer" aria-label="LinkedIn">
                    <i class="fab fa-linkedin-in"></i>
                </a>
            </div>
        </div>

        <!-- Avatar & 3D Orbital HUD Rings -->
        <div class="hero-image">
            <div class="hud-orbital-wrapper">
                <div class="orbital-ring ring-outer"></div>
                <div class="orbital-ring ring-inner"></div>
                <div class="avatar-aura"></div>
                
                <img src="<%= basePath %>/images/pitch.png" alt="Ricardo Romão" class="hero-avatar">
                
                <!-- Floating Tech Chips -->
                <div class="floating-badge badge-1">
                    <i class="fab fa-node-js"></i> NODE.JS // EXPRESS
                </div>
                <div class="floating-badge badge-2">
                    <i class="fab fa-docker"></i> DOCKER // K8S
                </div>
                <div class="floating-badge badge-3">
                    <i class="fas fa-shield-alt"></i> E2EE // CYBERSEC
                </div>
                <div class="floating-badge badge-4">
                    <i class="fab fa-python"></i> PYTHON // FASTAPI
                </div>
            </div>
        </div>
    </div>

    <!-- Equalizer Visualizer -->
    <div class="hud-visualizer">
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
    </div>

    <div class="scroll-down">
        <span>SYS_SCROLL // DOWN</span>
        <div class="scroll-mouse">
            <div class="scroll-wheel"></div>
        </div>
    </div>
</section>

<script>
    // Typing Effect
    const typedTextSpan = document.querySelector(".typed-text");
    const cursor = document.querySelector(".cursor");
    const words = <% if (lang === 'en') { %> ["build websites", "design interfaces", "create experiences", "code solutions"] <% } else { %> ["desenvolvo websites", "desenho interfaces", "crio experiências", "escrevo código"] <% } %>;
    let wordIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    let typeSpeed = 100;
    let deleteSpeed = 50;
    let waitTime = 2000;

    function type() {
        const currentWord = words[wordIndex];

        if (isDeleting) {
            // Delete character
            typedTextSpan.textContent = currentWord.substring(0, charIndex - 1);
            charIndex--;
            typeSpeed = deleteSpeed;
        } else {
            // Type character
            typedTextSpan.textContent = currentWord.substring(0, charIndex + 1);
            charIndex++;
            typeSpeed = 100 + Math.random() * 50;
        }

        // Check if word is complete
        if (!isDeleting && charIndex === currentWord.length) {
            // Pause at end of word
            typeSpeed = waitTime;
            isDeleting = true;
        } else if (isDeleting && charIndex === 0) {
            // Move to next word
            isDeleting = false;
            wordIndex = (wordIndex + 1) % words.length;
        }

        setTimeout(type, typeSpeed);
    }

    // Start the typing effect
    document.addEventListener("DOMContentLoaded", () => {
        // Start typing after a short delay
        setTimeout(type, 1000);

        // Audio visualizer animation
        const bars = document.querySelectorAll('.bar');
        setInterval(() => {
            bars.forEach(bar => {
                const height = Math.random() * 100;
                bar.style.height = `${height}%`;
                bar.style.backgroundColor = `hsl(${Math.random() * 60 + 180}, 100%, 50%)`;
            });
        }, 150);
    });
</script>