<!-- Interactive Recruiter CLI Terminal Easter Egg Modal -->
<div id="terminal-modal" class="terminal-modal-overlay" aria-hidden="true">
    <div class="terminal-window">
        <div class="terminal-window-header">
            <div class="terminal-window-controls">
                <span class="term-btn term-close" id="terminal-close-btn" title="Close (ESC)"></span>
                <span class="term-btn term-minimize"></span>
                <span class="term-btn term-maximize"></span>
            </div>
            <div class="terminal-window-title">
                <i class="fas fa-terminal"></i> RICARDO_ROMÃO_OS // RECRUITER_CLI_v4.2
            </div>
            <div class="terminal-window-actions">
                <button class="term-action-btn" id="terminal-help-btn" title="Show Commands">HELP</button>
            </div>
        </div>
        <div class="terminal-window-body" id="terminal-body">
            <div id="terminal-output">
                <div class="term-banner">
                    <pre class="term-ascii">
  ____  ___   ____    _    ____  ____   ___   ____   ___  __  __   _   ___  
 |  _ \|_ _| / ___|  / \  |  _ \|  _ \ / _ \ |  _ \ / _ \|  \/  | / \ / _ \ 
 | |_) || | | |     / _ \ | |_) | | | | | | || |_) | | | | |\/| |/ _ \ | | |
 |  _ < | | | |___ / ___ \|  _ <| |_| | |_| ||  _ <| |_| | |  | / ___ \ |_| |
 |_| \_\___| \____/_/   \_\_| \_\____/ \___/ |_| \_\\___/|_|  |_/_/   \_\___/ 
                    </pre>
                    <p class="term-welcome">
                        Welcome to <span class="term-cyan">Ricardo Romão's Interactive CLI</span>. Designed for
                        recruiters, engineering leads & tech enthusiasts.<br>
                        Type <span class="term-magenta">'help'</span> to view available commands or <span
                            class="term-emerald">'sudo hire_ricardo'</span> for instant recruitment access.
                    </p>
                    <p class="term-hint">// Press <kbd>ESC</kbd> or type <kbd>exit</kbd> to close terminal at any time.
                    </p>
                    <hr class="term-hr">
                </div>
            </div>
            <form id="terminal-input-form" class="terminal-input-line">
                <span class="term-prompt-user">recruiter@ricardo-romao:~$</span>
                <input type="text" id="terminal-input" autocomplete="off" spellcheck="false"
                    placeholder="type a command... (e.g. help, whoami, cv)" autofocus>
            </form>
        </div>
    </div>
</div>

<!-- Floating Cyber Terminal Trigger Badge -->
<button id="terminal-trigger-btn" class="terminal-floating-trigger" title="Open Interactive CLI (Ctrl + K / ~)">
    <i class="fas fa-terminal"></i>
    <span>[ CLI ]</span>
</button>