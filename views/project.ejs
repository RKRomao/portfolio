<% layout('layout') -%>

<%
  const projectTitle = project['title_' + lang] || project.title;
  const projectDescription = project['description_' + lang] || project.description;
  const projectTechnologies = project['technologies_' + lang] || project.technologies;
  const projectFeatures = project['features_' + lang] || project.features;
  const projectDetailedDescription = project['detailedDescription_' + lang] || project.detailedDescription;
%>

<section class="project-detail-section">
    <div class="container">
        <a href="<%= linkTo('/#projects') %>" class="back-link">
            <i class="fas fa-arrow-left"></i> <%= lang === 'en' ? 'Back to Projects' : 'Voltar aos Projetos' %>
        </a>
        <div class="project-header">
            <h1 class="project-title" data-matrix-title="<%= project.title_matrix %>"><%= projectTitle %></h1>
            <div class="project-meta">
                <span class="project-date"><i class="far fa-calendar-alt"></i> <%= new Date(project.createdAt).toLocaleDateString() %></span>
            </div>
        </div>

        <div class="project-content">
            <div class="project-image">
                <img src="<%= basePath %><%= project.image %>" alt="<%= projectTitle %>" class="project-main-image">
            </div>
            
            <div class="project-description">
                <% if (projectDescription) { %>
                    <div class="markdown-content project-short-desc" data-matrix-desc="<%= project.description_matrix %>">
                        <%- renderMarkdown(projectDescription) %>
                    </div>
                <% } %>
                <div class="project-details">
                    <% if (projectTechnologies) { %>
                        <h3><%= t('project_label_tech') %></h3>
                        <div class="markdown-content">
                            <%- renderMarkdown(projectTechnologies) %>
                        </div>
                    <% } %>
                    
                    <% if (projectFeatures) { %>
                        <h3><%= t('project_label_features') %></h3>
                        <div class="markdown-content">
                            <%- renderMarkdown(projectFeatures) %>
                        </div>
                    <% } %>
                    
                    <% if (projectDetailedDescription) { %>
                        <h3><%= t('project_label_details') %></h3>
                        <div class="markdown-content">
                            <%- renderMarkdown(projectDetailedDescription) %>
                        </div>
                    <% } %>
                </div>

                <% if (project.tags && project.tags.length > 0) { %>
                    <div class="project-tags project-detail-tags">
                        <% project.tags.forEach(tag => { %>
                            <span class="tag"><%= tag %></span>
                        <% }); %>
                    </div>
                <% } %>
                
                <div class="project-links">
                    <% if (project.projectUrl) { %>
                        <a href="<%= project.projectUrl %>" class="btn btn-laser btn-primary" target="_blank"><i class="fas fa-external-link-alt"></i> <%= t('project_btn_view') %></a>
                    <% } %>
                    <% if (project.githubUrl) { %>
                        <a href="<%= project.githubUrl %>" class="btn btn-laser btn-secondary" target="_blank"><i class="fab fa-github"></i> <%= t('project_btn_source') %></a>
                    <% } %>
                    <% if (project.reportUrl) { %>
                        <a href="<%= basePath %><%= project.reportUrl %>" class="btn btn-laser btn-secondary" target="_blank">
                            <i class="fas fa-file-pdf"></i> <%= t('project_btn_report') %>
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>

